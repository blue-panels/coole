{
  "autostart": "ide",
  "completion_on_trigger": "ide",
  "completion_on_arguments": "never",
  "backends": [
    {
      "id": "clangd",
      "command": ["clangd", "--background-index", "--compile-commands-dir=${build_dir}"],
      "extensions": {".c": "c", ".h": "c", ".cc": "cpp", ".cpp": "cpp", ".cxx": "cpp",
                     ".hh": "cpp", ".hpp": "cpp", ".hxx": "cpp", ".m": "objective-c"},
      "root_markers": ["compile_commands.json", "compile_flags.txt"]
    },
    {
      "id": "pylsp",
      "command": ["pylsp"],
      "extensions": {".py": "python"},
      "root_markers": ["pyproject.toml", "setup.py", "setup.cfg"],
      "settings": {"pylsp": {"plugins": {"jedi_completion": {"include_params": true}}}}
    },
    {
      "id": "pyright",
      "command": ["pyright-langserver", "--stdio"],
      "extensions": {".py": "python"},
      "root_markers": ["pyproject.toml", "pyrightconfig.json"]
    },
    {
      "id": "rust-analyzer",
      "command": ["rust-analyzer"],
      "extensions": {".rs": "rust"},
      "root_markers": ["Cargo.toml"],
      "single_file": false
    },
    {
      "id": "gopls",
      "command": ["gopls"],
      "extensions": {".go": "go"},
      "root_markers": ["go.mod", "go.work"]
    },
    {
      "id": "typescript",
      "command": ["typescript-language-server", "--stdio"],
      "extensions": {".ts": "typescript", ".tsx": "typescriptreact",
                     ".js": "javascript", ".jsx": "javascriptreact"},
      "root_markers": ["package.json", "tsconfig.json", "jsconfig.json"]
    },
    {
      "id": "bash",
      "command": ["bash-language-server", "start"],
      "extensions": {".sh": "shellscript", ".bash": "shellscript"}
    },
    {
      "id": "lua",
      "command": ["lua-language-server"],
      "extensions": {".lua": "lua"},
      "root_markers": [".luarc.json"]
    },
    {
      "id": "mongodb",
      "command": ["mongolsp"],
      "extensions": {".js": "javascript", ".mongodb": "javascript"},
      "startup": "query",
      "words": ["db", "sp", "use", "async", "await", "break", "case", "catch", "class", "const", "continue",
                "default", "delete", "do", "else", "false", "finally", "for", "function", "if",
                "in", "instanceof", "let", "new", "null", "of", "return", "switch", "this",
                "throw", "true", "try", "typeof", "undefined", "var", "while",
                "Array", "Boolean", "Date", "Error", "JSON", "Map", "Math", "Number", "Object",
                "Promise", "RegExp", "Set", "String", "console", "isNaN", "parseFloat", "parseInt",
                "print", "printjson", "connect", "load", "sleep", "quit", "Mongo",
                "ObjectId", "ISODate", "UUID", "NumberInt", "NumberLong", "NumberDecimal",
                "Timestamp", "BinData", "MinKey", "MaxKey", "BSONRegExp", "Code", "DBRef", "EJSON",
                "rs", "sh"],
      "requests": [
        {"method": "INITIALIZE_MONGODB_SERVICE",
         "params": {"extensionPath": "${command_dir}/..", "connectionId": null}},
        {"method": "ACTIVE_CONNECTION_CHANGED",
         "params": {"connectionId": "coole", "connectionString": "${env:MC_MONGO_URI}",
                    "connectionOptions": {}}}
      ]
    }
  ]
}
