# The message of a git commit: COMMIT_EDITMSG, the file the git plugin of coole writes for
# one (COOLE_EDITMSG, COOLE_AMEND_EDITMSG, COOLE_REWORD_EDITMSG), MERGE_MSG and TAG_EDITMSG.  The lines git leaves out are dimmed, the
# trailers stand out.

context default
    keyword linestart Signed-off-by: CONSTANT_OTHER_TRAILER
    keyword linestart Co-authored-by: CONSTANT_OTHER_TRAILER
    keyword linestart Co-Authored-By: CONSTANT_OTHER_TRAILER
    keyword linestart Reviewed-by: CONSTANT_OTHER_TRAILER
    keyword linestart Acked-by: CONSTANT_OTHER_TRAILER
    keyword linestart Reported-by: CONSTANT_OTHER_TRAILER
    keyword linestart Suggested-by: CONSTANT_OTHER_TRAILER
    keyword linestart Tested-by: CONSTANT_OTHER_TRAILER
    keyword linestart Fixes: CONSTANT_OTHER_TRAILER
    keyword linestart Closes: CONSTANT_OTHER_TRAILER
    keyword linestart Refs: CONSTANT_OTHER_TRAILER
    keyword linestart Change-Id: CONSTANT_OTHER_TRAILER
    keyword #\{0123456789\}\[0123456789\] ENTITY_NAME_REFERENCE

# what git leaves out of the message
context linestart # \n COMMENT_LINE
    keyword modified: MARKUP_CHANGED
    keyword new\sfile: MARKUP_INSERTED
    keyword deleted: MARKUP_DELETED
    keyword renamed: MARKUP_CHANGED
    keyword typechange: MARKUP_CHANGED
    keyword both\smodified: MARKUP_DELETED
