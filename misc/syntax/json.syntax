#
# JSON syntax highlighting
# for MC Editor/CoolEdit
#
# Author: Sergii Pylypenko <x.pelya.x@gmail.com>
#
# Keys, string values, numbers and constants each have a color of their own.
# A key is a string followed by a colon, and the colon takes its color: the
# rules cannot look ahead of what they color.  A key that holds an escaped
# quote is colored as a value.

context default

    #=========================
    # Keys
    keyword "*"\[\s\t\]: SUPPORT_TYPE_PROPERTY_NAME

    #=========================
    # Constants
    keyword whole true CONSTANT_LANGUAGE
    keyword whole false CONSTANT_LANGUAGE
    keyword whole null CONSTANT_LANGUAGE

    #=========================
    # Numbers, the longest form first: the first that fits is taken
    keyword whole \[-\]\{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{\-\+\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \[-\]\{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \[-\]\{0123456789\}\[0123456789\]\{eE\}\{\-\+\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \[-\]\{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \[-\]\{0123456789\}\[0123456789\]\.\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \[-\]\{0123456789\}\[0123456789\] CONSTANT_NUMERIC

    #=========================
    # Separators
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword , PUNCTUATION_SEPARATOR
    keyword : PUNCTUATION_SEPARATOR

#=============================
# Comments.  JSON has none, but many files that are read as JSON take them:
# "//" to the end of the line, and "/* */"
context // \n COMMENT_LINE
    spellcheck

context /\* \*/ COMMENT_BLOCK
    spellcheck

#=============================
# String values
context " " STRING_QUOTED_DOUBLE
    spellcheck
    keyword \\\{"\\/bfnrt\} CONSTANT_CHARACTER_ESCAPE
    keyword \\u\{0123456789ABCDEFabcdef\}\{0123456789ABCDEFabcdef\}\{0123456789ABCDEFabcdef\}\{0123456789ABCDEFabcdef\} CONSTANT_CHARACTER_ESCAPE
