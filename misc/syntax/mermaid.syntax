# Mermaid diagrams, https://mermaid.js.org
#
# The type of the diagram, the words the types know, arrows and relations,
# edge labels, strings, comments and directives.
#
# The text of a node, A[text], B(text) or C{text}, and what follows a colon -
# the message of a sequence, the description of a state, the data of a task -
# is left plain, and keeps to its line.  The brace of an ER relation belongs
# to the relation, and the one that opens a class body ends its line.

context default
    keyword whole graph STORAGE_TYPE_DIAGRAM
    keyword whole flowchart STORAGE_TYPE_DIAGRAM
    keyword whole sequenceDiagram STORAGE_TYPE_DIAGRAM
    keyword whole classDiagram STORAGE_TYPE_DIAGRAM
    keyword whole stateDiagram-v2 STORAGE_TYPE_DIAGRAM
    keyword whole stateDiagram STORAGE_TYPE_DIAGRAM
    keyword whole erDiagram STORAGE_TYPE_DIAGRAM
    keyword whole gantt STORAGE_TYPE_DIAGRAM
    keyword whole pie STORAGE_TYPE_DIAGRAM
    keyword whole journey STORAGE_TYPE_DIAGRAM
    keyword whole gitGraph STORAGE_TYPE_DIAGRAM
    keyword whole mindmap STORAGE_TYPE_DIAGRAM
    keyword whole timeline STORAGE_TYPE_DIAGRAM
    keyword whole quadrantChart STORAGE_TYPE_DIAGRAM
    keyword whole requirementDiagram STORAGE_TYPE_DIAGRAM
    keyword whole C4Context STORAGE_TYPE_DIAGRAM
    keyword whole C4Container STORAGE_TYPE_DIAGRAM
    keyword whole C4Component STORAGE_TYPE_DIAGRAM
    keyword whole C4Dynamic STORAGE_TYPE_DIAGRAM
    keyword whole C4Deployment STORAGE_TYPE_DIAGRAM
    keyword whole sankey-beta STORAGE_TYPE_DIAGRAM
    keyword whole xychart-beta STORAGE_TYPE_DIAGRAM
    keyword whole block-beta STORAGE_TYPE_DIAGRAM
    keyword whole packet-beta STORAGE_TYPE_DIAGRAM
    keyword whole architecture-beta STORAGE_TYPE_DIAGRAM
    keyword whole kanban STORAGE_TYPE_DIAGRAM
    keyword whole zenuml STORAGE_TYPE_DIAGRAM

    keyword whole TB CONSTANT_OTHER
    keyword whole TD CONSTANT_OTHER
    keyword whole BT CONSTANT_OTHER
    keyword whole RL CONSTANT_OTHER
    keyword whole LR CONSTANT_OTHER

    keyword whole subgraph KEYWORD_OTHER
    keyword whole end KEYWORD_OTHER
    keyword whole direction KEYWORD_OTHER
    keyword whole click KEYWORD_OTHER
    keyword whole href KEYWORD_OTHER
    keyword whole style KEYWORD_OTHER
    keyword whole classDef KEYWORD_OTHER
    keyword whole class KEYWORD_OTHER
    keyword whole linkStyle KEYWORD_OTHER
    keyword whole participant KEYWORD_OTHER
    keyword whole actor KEYWORD_OTHER
    keyword whole Note KEYWORD_OTHER
    keyword whole note KEYWORD_OTHER
    keyword whole loop KEYWORD_OTHER
    keyword whole alt KEYWORD_OTHER
    keyword whole else KEYWORD_OTHER
    keyword whole opt KEYWORD_OTHER
    keyword whole par KEYWORD_OTHER
    keyword whole critical KEYWORD_OTHER
    keyword whole break KEYWORD_OTHER
    keyword whole rect KEYWORD_OTHER
    keyword whole activate KEYWORD_OTHER
    keyword whole deactivate KEYWORD_OTHER
    keyword whole autonumber KEYWORD_OTHER
    keyword whole box KEYWORD_OTHER
    keyword whole namespace KEYWORD_OTHER
    keyword whole state KEYWORD_OTHER
    keyword whole title KEYWORD_OTHER
    keyword whole dateFormat KEYWORD_OTHER
    keyword whole axisFormat KEYWORD_OTHER
    keyword whole tickInterval KEYWORD_OTHER
    keyword whole todayMarker KEYWORD_OTHER
    keyword whole excludes KEYWORD_OTHER
    keyword whole section KEYWORD_OTHER
    keyword whole after KEYWORD_OTHER
    keyword whole crit KEYWORD_OTHER
    keyword whole done KEYWORD_OTHER
    keyword whole active KEYWORD_OTHER
    keyword whole milestone KEYWORD_OTHER
    keyword whole showData KEYWORD_OTHER
    keyword whole accTitle KEYWORD_OTHER
    keyword whole accDescr KEYWORD_OTHER
    keyword whole x-axis KEYWORD_OTHER
    keyword whole y-axis KEYWORD_OTHER
    keyword whole quadrant-1 KEYWORD_OTHER
    keyword whole quadrant-2 KEYWORD_OTHER
    keyword whole quadrant-3 KEYWORD_OTHER
    keyword whole quadrant-4 KEYWORD_OTHER
    keyword whole commit KEYWORD_OTHER
    keyword whole branch KEYWORD_OTHER
    keyword whole checkout KEYWORD_OTHER
    keyword whole merge KEYWORD_OTHER
    keyword whole cherry-pick KEYWORD_OTHER
    keyword whole HIGHLIGHT KEYWORD_OTHER
    keyword whole REVERSE KEYWORD_OTHER
    keyword whole NORMAL KEYWORD_OTHER

    # arrows and relations; the longer first, as the first that fits is taken
    keyword \{|}\}\{|o\}\{-.\}\{-.\}\{|o\}\{|{\} KEYWORD_OPERATOR_ARROW
    keyword <--> KEYWORD_OPERATOR_ARROW
    keyword <==> KEYWORD_OPERATOR_ARROW
    keyword <-.-> KEYWORD_OPERATOR_ARROW
    keyword -.-> KEYWORD_OPERATOR_ARROW
    keyword -->> KEYWORD_OPERATOR_ARROW
    keyword ->> KEYWORD_OPERATOR_ARROW
    keyword <|-- KEYWORD_OPERATOR_ARROW
    keyword --|> KEYWORD_OPERATOR_ARROW
    keyword --\* KEYWORD_OPERATOR_ARROW
    keyword --> KEYWORD_OPERATOR_ARROW
    keyword ==> KEYWORD_OPERATOR_ARROW
    keyword wholeright --x KEYWORD_OPERATOR_ARROW
    keyword wholeright --o KEYWORD_OPERATOR_ARROW
    keyword --- KEYWORD_OPERATOR_ARROW
    keyword --) KEYWORD_OPERATOR_ARROW
    keyword -- KEYWORD_OPERATOR_ARROW
    keyword === KEYWORD_OPERATOR_ARROW
    keyword -.- KEYWORD_OPERATOR_ARROW
    keyword -) KEYWORD_OPERATOR_ARROW
    keyword wholeright -x KEYWORD_OPERATOR_ARROW
    keyword -> KEYWORD_OPERATOR_ARROW
    keyword ~~~ KEYWORD_OPERATOR_ARROW
    keyword <|.. KEYWORD_OPERATOR_ARROW
    keyword ..|> KEYWORD_OPERATOR_ARROW
    keyword ..> KEYWORD_OPERATOR_ARROW
    keyword .. KEYWORD_OPERATOR_ARROW
    keyword <.. KEYWORD_OPERATOR_ARROW
    keyword \*-- KEYWORD_OPERATOR_ARROW
    keyword wholeleft o-- KEYWORD_OPERATOR_ARROW

    # the marks of nodes, groups and annotations
    keyword [\*] PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    keyword << PUNCTUATION_SECTION
    keyword >> PUNCTUATION_SECTION
    keyword : PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_SEPARATOR

# a directive: %%{init: {...}}%%
context %%{ }%% META_PREPROCESSOR

# a comment
context %% \n COMMENT_LINE

# the text of a node
context exclusive oneline [ ]
context exclusive oneline ( )
context exclusive oneline { }

# the label of an edge: A -->|label| B
context oneline | | STRING_UNQUOTED

# a message, a description, the data of a task
context exclusive : \n

context oneline " " STRING_QUOTED_DOUBLE
