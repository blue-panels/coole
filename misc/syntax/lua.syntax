#
# Lua syntax highlighting
#
# History:
#
# - 2026: Update language, literals, escapes, operators and standard library for Lua 5.4. (smind)
# - 2015: Support for long strings and long comments.
# - 2011: String-literal fixes.
# - 2005: Started by Mike Gorchak <lestat@i.com.ua>

context default

# Keywords
    keyword whole and KEYWORD_OPERATOR_WORD
    keyword whole break KEYWORD_CONTROL
    keyword whole do KEYWORD_CONTROL
    keyword whole else KEYWORD_CONTROL
    keyword whole elseif KEYWORD_CONTROL
    keyword whole end KEYWORD_CONTROL
    keyword whole for KEYWORD_CONTROL
    keyword whole function STORAGE_TYPE_FUNCTION
    keyword whole goto KEYWORD_CONTROL
    keyword whole if KEYWORD_CONTROL
    keyword whole in KEYWORD_CONTROL
    keyword whole local STORAGE_MODIFIER
    keyword whole not KEYWORD_OPERATOR_WORD
    keyword whole or KEYWORD_OPERATOR_WORD
    keyword whole repeat KEYWORD_CONTROL
    keyword whole return KEYWORD_CONTROL
    keyword whole then KEYWORD_CONTROL
    keyword whole until KEYWORD_CONTROL
    keyword whole while KEYWORD_CONTROL

# Literal constants
    keyword whole false CONSTANT_LANGUAGE
    keyword whole nil CONSTANT_LANGUAGE
    keyword whole true CONSTANT_LANGUAGE

# Lua 5.4 variable attributes (const and close are not keywords on their own)
    keyword <const> STORAGE_MODIFIER
    keyword <close> STORAGE_MODIFIER

# Numbers
    wholechars abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_

    keyword whole 0\{xX\}\{0123456789abcdefABCDEF\}\[0123456789abcdefABCDEF\]\.\[0123456789abcdefABCDEF\]\{pP\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole 0\{xX\}\{0123456789abcdefABCDEF\}\[0123456789abcdefABCDEF\]\.\[0123456789abcdefABCDEF\]\{pP\}\{\-\+\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole 0\{xX\}\{0123456789abcdefABCDEF\}\[0123456789abcdefABCDEF\]\{pP\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole 0\{xX\}\{0123456789abcdefABCDEF\}\[0123456789abcdefABCDEF\]\{pP\}\{\-\+\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole 0\{xX\}\{0123456789abcdefABCDEF\}\[0123456789abcdefABCDEF\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \[0123456789\]\.\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\.\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\{eE\}\{\-\+\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\.\[0123456789\]\{eE\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC
    keyword whole \{0123456789\}\[0123456789\]\.\[0123456789\]\{eE\}\{\-\+\}\{0123456789\}\[0123456789\] CONSTANT_NUMERIC

# Comment and string delimiters
    keyword -- COMMENT_LINE
    keyword ]\[=\]] COMMENT_BLOCK
    # The following colorizes the start delimiter of "long" strings.
    # The start delimiter of "long" comments isn't affected by the following
    # directive but gets its color from the "--" above (gods know why).
    keyword [\[=\][ COMMENT_BLOCK

# Operators
    # Field names.  The syntax engine has no lookbehind, so '.' is part of the
    # match; unlike a context rule, this cannot leak into following text.
    keyword .\{abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_\}+ VARIABLE_OTHER_MEMBER
    keyword ... KEYWORD_OPERATOR
    keyword .. KEYWORD_OPERATOR
    keyword // KEYWORD_OPERATOR
    keyword << KEYWORD_OPERATOR
    keyword >> KEYWORD_OPERATOR
    keyword <= KEYWORD_OPERATOR
    keyword >= KEYWORD_OPERATOR
    keyword == KEYWORD_OPERATOR
    keyword ~= KEYWORD_OPERATOR
    keyword :: PUNCTUATION_SECTION
    keyword ( PUNCTUATION_SECTION
    keyword ) PUNCTUATION_SECTION
    keyword { PUNCTUATION_SECTION
    keyword } PUNCTUATION_SECTION
    keyword [ PUNCTUATION_SECTION
    keyword ] PUNCTUATION_SECTION
    keyword . KEYWORD_OPERATOR
    keyword , PUNCTUATION_SEPARATOR
    keyword ; PUNCTUATION_TERMINATOR
    keyword : PUNCTUATION_SEPARATOR
    keyword = KEYWORD_OPERATOR
    keyword > KEYWORD_OPERATOR
    keyword < KEYWORD_OPERATOR
    keyword \+ KEYWORD_OPERATOR
    keyword - KEYWORD_OPERATOR
    keyword \* KEYWORD_OPERATOR
    keyword / KEYWORD_OPERATOR
    keyword % KEYWORD_OPERATOR
    keyword ^ KEYWORD_OPERATOR
    keyword # KEYWORD_OPERATOR
    keyword & KEYWORD_OPERATOR
    keyword | KEYWORD_OPERATOR
    keyword ~ KEYWORD_OPERATOR


# Library Functions

    # basiclib
    keyword whole error SUPPORT_FUNCTION
    keyword whole getmetatable SUPPORT_FUNCTION
    keyword whole setmetatable SUPPORT_FUNCTION
    keyword whole getfenv SUPPORT_FUNCTION
    keyword whole setfenv SUPPORT_FUNCTION
    keyword whole next SUPPORT_FUNCTION
    keyword whole ipairs SUPPORT_FUNCTION
    keyword whole pairs SUPPORT_FUNCTION
    keyword whole print SUPPORT_FUNCTION
    keyword whole tonumber SUPPORT_FUNCTION
    keyword whole tostring SUPPORT_FUNCTION
    keyword whole type SUPPORT_FUNCTION
    keyword whole assert SUPPORT_FUNCTION
    #keyword whole unpack yellow    # modern code should use table.unpack()
    keyword whole rawequal SUPPORT_FUNCTION
    keyword whole rawget SUPPORT_FUNCTION
    keyword whole rawlen SUPPORT_FUNCTION
    keyword whole rawset SUPPORT_FUNCTION
    keyword whole pcall SUPPORT_FUNCTION
    keyword whole xpcall SUPPORT_FUNCTION
    keyword whole collectgarbage SUPPORT_FUNCTION
    keyword whole gcinfo SUPPORT_FUNCTION
    keyword whole loadfile SUPPORT_FUNCTION
    keyword whole load SUPPORT_FUNCTION
    keyword whole dofile SUPPORT_FUNCTION
    keyword whole loadstring SUPPORT_FUNCTION
    keyword whole require SUPPORT_FUNCTION
    keyword whole select SUPPORT_FUNCTION
    keyword whole warn SUPPORT_FUNCTION
    keyword whole coroutine.create SUPPORT_FUNCTION
    keyword whole coroutine.wrap SUPPORT_FUNCTION
    keyword whole coroutine.resume SUPPORT_FUNCTION
    keyword whole coroutine.yield SUPPORT_FUNCTION
    keyword whole coroutine.status SUPPORT_FUNCTION
    keyword whole coroutine.isyieldable SUPPORT_FUNCTION
    keyword whole coroutine.running SUPPORT_FUNCTION
    keyword whole coroutine.close SUPPORT_FUNCTION

    # stringlib
    keyword whole string.len SUPPORT_FUNCTION
    keyword whole string.sub SUPPORT_FUNCTION
    keyword whole string.lower SUPPORT_FUNCTION
    keyword whole string.upper SUPPORT_FUNCTION
    keyword whole string.char SUPPORT_FUNCTION
    keyword whole string.rep SUPPORT_FUNCTION
    keyword whole string.byte SUPPORT_FUNCTION
    keyword whole string.format SUPPORT_FUNCTION
    keyword whole string.dump SUPPORT_FUNCTION
    keyword whole string.find SUPPORT_FUNCTION
    keyword whole string.gfind SUPPORT_FUNCTION
    keyword whole string.gsub SUPPORT_FUNCTION
    keyword whole string.gmatch SUPPORT_FUNCTION
    keyword whole string.match SUPPORT_FUNCTION
    keyword whole string.reverse SUPPORT_FUNCTION
    keyword whole string.pack SUPPORT_FUNCTION
    keyword whole string.packsize SUPPORT_FUNCTION
    keyword whole string.unpack SUPPORT_FUNCTION

    # tablelib
    keyword whole table.concat SUPPORT_FUNCTION
    keyword whole table.foreach SUPPORT_FUNCTION
    keyword whole table.foreachi SUPPORT_FUNCTION
    keyword whole table.getn SUPPORT_FUNCTION
    keyword whole table.setn SUPPORT_FUNCTION
    keyword whole table.sort SUPPORT_FUNCTION
    keyword whole table.insert SUPPORT_FUNCTION
    keyword whole table.remove SUPPORT_FUNCTION
    keyword whole table.unpack SUPPORT_FUNCTION
    keyword whole table.pack SUPPORT_FUNCTION
    keyword whole table.move SUPPORT_FUNCTION

    # mathlib
    keyword whole math.abs SUPPORT_FUNCTION
    keyword whole math.sin SUPPORT_FUNCTION
    keyword whole math.cos SUPPORT_FUNCTION
    keyword whole math.tan SUPPORT_FUNCTION
    keyword whole math.asin SUPPORT_FUNCTION
    keyword whole math.acos SUPPORT_FUNCTION
    keyword whole math.atan SUPPORT_FUNCTION
    keyword whole math.atan2 SUPPORT_FUNCTION
    keyword whole math.ceil SUPPORT_FUNCTION
    keyword whole math.floor SUPPORT_FUNCTION
    keyword whole math.mod SUPPORT_FUNCTION
    keyword whole math.frexp SUPPORT_FUNCTION
    keyword whole math.ldexp SUPPORT_FUNCTION
    keyword whole math.sqrt SUPPORT_FUNCTION
    keyword whole math.min SUPPORT_FUNCTION
    keyword whole math.max SUPPORT_FUNCTION
    keyword whole math.log SUPPORT_FUNCTION
    keyword whole math.log10 SUPPORT_FUNCTION
    keyword whole math.exp SUPPORT_FUNCTION
    keyword whole math.deg SUPPORT_FUNCTION
    keyword whole math.pow SUPPORT_FUNCTION
    keyword whole math.rad SUPPORT_FUNCTION
    keyword whole math.random SUPPORT_FUNCTION
    keyword whole math.randomseed SUPPORT_FUNCTION
    keyword whole math.fmod SUPPORT_FUNCTION
    keyword whole math.modf SUPPORT_FUNCTION
    keyword whole math.tointeger SUPPORT_FUNCTION
    keyword whole math.type SUPPORT_FUNCTION
    keyword whole math.ult SUPPORT_FUNCTION
    keyword whole math.huge SUPPORT_CONSTANT
    keyword whole math.maxinteger SUPPORT_CONSTANT
    keyword whole math.mininteger SUPPORT_CONSTANT
    keyword whole math.pi SUPPORT_CONSTANT

    # iolib
    keyword whole io.input SUPPORT_FUNCTION
    keyword whole io.output SUPPORT_FUNCTION
    keyword whole io.lines SUPPORT_FUNCTION
    keyword whole io.close SUPPORT_FUNCTION
    keyword whole io.flush SUPPORT_FUNCTION
    keyword whole io.open SUPPORT_FUNCTION
    keyword whole io.popen SUPPORT_FUNCTION
    keyword whole io.read SUPPORT_FUNCTION
    keyword whole io.tmpfile SUPPORT_FUNCTION
    keyword whole io.type SUPPORT_FUNCTION
    keyword whole io.write SUPPORT_FUNCTION

    # filelib
    keyword whole file.flush SUPPORT_FUNCTION
    keyword whole file.read SUPPORT_FUNCTION
    keyword whole file.lines SUPPORT_FUNCTION
    keyword whole file.seek SUPPORT_FUNCTION
    keyword whole file.write SUPPORT_FUNCTION
    keyword whole file.close SUPPORT_FUNCTION
    keyword whole file.__gc SUPPORT_FUNCTION
    keyword whole file.__tostring SUPPORT_FUNCTION

    # syslib
    keyword whole os.clock SUPPORT_FUNCTION
    keyword whole os.date SUPPORT_FUNCTION
    keyword whole os.difftime SUPPORT_FUNCTION
    keyword whole os.execute SUPPORT_FUNCTION
    keyword whole os.exit SUPPORT_FUNCTION
    keyword whole os.getenv SUPPORT_FUNCTION
    keyword whole os.remove SUPPORT_FUNCTION
    keyword whole os.rename SUPPORT_FUNCTION
    keyword whole os.setlocale SUPPORT_FUNCTION
    keyword whole os.time SUPPORT_FUNCTION
    keyword whole os.tmpname SUPPORT_FUNCTION

    # debuglib
    keyword whole debug.getlocal SUPPORT_FUNCTION
    keyword whole debug.getinfo SUPPORT_FUNCTION
    keyword whole debug.gethook SUPPORT_FUNCTION
    keyword whole debug.getupvalue SUPPORT_FUNCTION
    keyword whole debug.sethook SUPPORT_FUNCTION
    keyword whole debug.setlocal SUPPORT_FUNCTION
    keyword whole debug.setupvalue SUPPORT_FUNCTION
    keyword whole debug.debug SUPPORT_FUNCTION
    keyword whole debug.traceback SUPPORT_FUNCTION
    keyword whole debug.getmetatable SUPPORT_FUNCTION
    keyword whole debug.setmetatable SUPPORT_FUNCTION
    keyword whole debug.getregistry SUPPORT_FUNCTION
    keyword whole debug.getuservalue SUPPORT_FUNCTION
    keyword whole debug.setuservalue SUPPORT_FUNCTION
    keyword whole debug.upvalueid SUPPORT_FUNCTION
    keyword whole debug.upvaluejoin SUPPORT_FUNCTION

    # utf8lib
    keyword whole utf8.char SUPPORT_FUNCTION
    keyword whole utf8.charpattern SUPPORT_CONSTANT
    keyword whole utf8.codepoint SUPPORT_FUNCTION
    keyword whole utf8.codes SUPPORT_FUNCTION
    keyword whole utf8.len SUPPORT_FUNCTION
    keyword whole utf8.offset SUPPORT_FUNCTION

    # packagelib
    keyword whole package.config SUPPORT_CONSTANT
    keyword whole package.cpath SUPPORT_CONSTANT
    keyword whole package.loaded SUPPORT_CONSTANT
    keyword whole package.loadlib SUPPORT_FUNCTION
    keyword whole package.path SUPPORT_CONSTANT
    keyword whole package.preload SUPPORT_CONSTANT
    keyword whole package.searchers SUPPORT_CONSTANT
    keyword whole package.searchpath SUPPORT_FUNCTION

# Function names in declarations and calls.  The leading word boundary also
# handles method calls after '.' and ':'.
    keyword wholeleft +\[\s\]( VARIABLE_FUNCTION

# Global Variables
    keyword whole _VERSION SUPPORT_CONSTANT
    keyword whole _G SUPPORT_CONSTANT
    keyword whole _ENV SUPPORT_CONSTANT
    keyword whole io.stdin SUPPORT_CONSTANT
    keyword whole io.stdout SUPPORT_CONSTANT
    keyword whole io.stderr SUPPORT_CONSTANT

#
# Long comments
#

context exclusive --[[ ]] COMMENT_BLOCK
    # hightlights ldoc tags: "@todo", "@param", "@function" etc.
    keyword @\[abcdefghijklmnopqrstuvwxyz\] KEYWORD_OTHER base
    spellcheck
context exclusive --[=[ ]=] COMMENT_BLOCK
    keyword @\[abcdefghijklmnopqrstuvwxyz\] KEYWORD_OTHER base
    spellcheck
context exclusive --[==[ ]==] COMMENT_BLOCK
    keyword @\[abcdefghijklmnopqrstuvwxyz\] KEYWORD_OTHER base
    spellcheck
context exclusive --[===[ ]===] COMMENT_BLOCK
    keyword @\[abcdefghijklmnopqrstuvwxyz\] KEYWORD_OTHER base
    spellcheck
# 4 equals and up (the number of ='s doesn't have to match, but that's the best we can do):
context exclusive --[====\[=\][ ]====\[=\]] COMMENT_BLOCK
    keyword @\[abcdefghijklmnopqrstuvwxyz\] KEYWORD_OTHER base
    spellcheck

#
# Long strings
#

context exclusive [[ ]] STRING_QUOTED_OTHER
    spellcheck
context exclusive [=[ ]=] STRING_QUOTED_OTHER
    spellcheck
context exclusive [==[ ]==] STRING_QUOTED_OTHER
    spellcheck
context exclusive [===[ ]===] STRING_QUOTED_OTHER
    spellcheck
# 4 equals and up (the number of ='s doesn't have to match, but that's the best we can do):
context exclusive [====\[=\][ ]====\[=\]] STRING_QUOTED_OTHER
    spellcheck


# Simple comments
context exclusive -- \n COMMENT_LINE
    keyword @\[abcdefghijklmnopqrstuvwxyz\] KEYWORD_OTHER base
    spellcheck

# Shebang line
context linestart #! \n COMMENT_LINE

# Strings
context " " STRING_QUOTED_DOUBLE
    keyword %a CONSTANT_OTHER_PLACEHOLDER
    keyword %c CONSTANT_OTHER_PLACEHOLDER
    keyword %d CONSTANT_OTHER_PLACEHOLDER
    keyword %l CONSTANT_OTHER_PLACEHOLDER
    keyword %p CONSTANT_OTHER_PLACEHOLDER
    keyword %q CONSTANT_OTHER_PLACEHOLDER
    keyword %s CONSTANT_OTHER_PLACEHOLDER
    keyword %u CONSTANT_OTHER_PLACEHOLDER
    keyword %w CONSTANT_OTHER_PLACEHOLDER
    keyword %x CONSTANT_OTHER_PLACEHOLDER
    keyword %z CONSTANT_OTHER_PLACEHOLDER
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE
    keyword \\z CONSTANT_CHARACTER_ESCAPE
    keyword \\x\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\} CONSTANT_CHARACTER_ESCAPE
    keyword \\u{*} CONSTANT_CHARACTER_ESCAPE
    keyword \\\{0123456789\}\{0123456789\}\{0123456789\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\{0123456789\}\{0123456789\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\{0123456789\} CONSTANT_CHARACTER_ESCAPE
    spellcheck

context ' ' STRING_QUOTED_SINGLE
    keyword %a CONSTANT_OTHER_PLACEHOLDER
    keyword %c CONSTANT_OTHER_PLACEHOLDER
    keyword %d CONSTANT_OTHER_PLACEHOLDER
    keyword %l CONSTANT_OTHER_PLACEHOLDER
    keyword %p CONSTANT_OTHER_PLACEHOLDER
    keyword %q CONSTANT_OTHER_PLACEHOLDER
    keyword %s CONSTANT_OTHER_PLACEHOLDER
    keyword %u CONSTANT_OTHER_PLACEHOLDER
    keyword %w CONSTANT_OTHER_PLACEHOLDER
    keyword %x CONSTANT_OTHER_PLACEHOLDER
    keyword %z CONSTANT_OTHER_PLACEHOLDER
    keyword \\\\ CONSTANT_CHARACTER_ESCAPE
    keyword \\" CONSTANT_CHARACTER_ESCAPE
    keyword \\' CONSTANT_CHARACTER_ESCAPE
    keyword \\\{abtnvfr\} CONSTANT_CHARACTER_ESCAPE
    keyword \\z CONSTANT_CHARACTER_ESCAPE
    keyword \\x\{0123456789abcdefABCDEF\}\{0123456789abcdefABCDEF\} CONSTANT_CHARACTER_ESCAPE
    keyword \\u{*} CONSTANT_CHARACTER_ESCAPE
    keyword \\\{0123456789\}\{0123456789\}\{0123456789\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\{0123456789\}\{0123456789\} CONSTANT_CHARACTER_ESCAPE
    keyword \\\{0123456789\} CONSTANT_CHARACTER_ESCAPE
    spellcheck
