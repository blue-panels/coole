# Maintainer: Ilia Maslakov <il.smind@gmail.com>

pkgbase=bluerig
pkgname=(bluerig bluerig-lua)
pkgver=@VERSION@
pkgrel=1
pkgdesc='Console text editor, a continuation of cooledit'
arch=('x86_64' 'aarch64')
url='https://github.com/blue-panels/bluerig'
license=('GPL-3.0-or-later')
makedepends=('meson' 'pkgconf' 'gettext' 'glib2' 'slang' 'gpm' 'lua' 'libx11')
options=('!emptydirs')
source=("bluerig-${pkgver}.tar.gz::${url}/releases/download/bluerig-${pkgver}/bluerig-${pkgver}.tar.gz")
# Filled in by packaging/prepare.sh from the release archive; SKIP when no
# archive was given to it.
b2sums=('@B2SUMS@')

build() {
  arch-meson "bluerig-${pkgver}" build \
    -Dscreen=slang \
    -Dplugins_dir=/usr/lib/bluerig/plugins \
    -Druntime_plugins_dir=/usr/lib/bluerig/runtime-plugins \
    -Dlua=enabled
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package_bluerig() {
  pkgdesc='Console text editor, a continuation of cooledit'
  depends=('glib2' 'slang' 'gpm')
  optdepends=('bluerig-lua: the Lua runtime and the editor scripts'
              'libx11: keyboard modifiers under X'
              'aspell: spell checking'
              'hunspell: spell checking'
              'ctags: the tag index the editor reads')
  backup=('etc/bluerig/bluerig.menu' 'etc/bluerig/ctags.keymap'
          'etc/bluerig/edit.indent.rc' 'etc/bluerig/keymap.default.ini'
          'etc/bluerig/keymap.emacs.ini' 'etc/bluerig/keymap.ini'
          'etc/bluerig/keymap.vim.ini' 'etc/bluerig/spell.keymap')

  meson install -C build --destdir "${pkgdir}"
  rm -rf "${pkgdir}/usr/lib/bluerig/runtime-plugins"
  rm -rf "${pkgdir}/usr/share/bluerig/lua"

  # keymap.ini is installed as a symlink to keymap.default.ini, and pacman
  # cannot keep a symlink through the backup mechanism: the user's edits would
  # be lost on upgrade. Ship it as a file. (Arch FS#50889)
  rm "${pkgdir}/etc/bluerig/keymap.ini"
  cp "${pkgdir}"/etc/bluerig/keymap{.default,}.ini
  install -Dm644 "bluerig-${pkgver}/COPYING" "${pkgdir}/usr/share/licenses/bluerig/COPYING"
  install -Dm644 "bluerig-${pkgver}/CHANGELOG.md" "${pkgdir}/usr/share/doc/bluerig/CHANGELOG.md"
}

package_bluerig-lua() {
  pkgdesc='Lua runtime and scripts for the bluerig text editor'
  depends=("bluerig=${pkgver}-${pkgrel}" 'glib2' 'lua')

  meson install -C build --destdir "${pkgdir}"
  rm -rf "${pkgdir}/etc" "${pkgdir}/usr/bin"
  # Keep the runtime plugin and the Lua scripts, drop everything else the
  # install put here: pacman refuses two packages that own the same file.
  find "${pkgdir}/usr/lib" -mindepth 1 -maxdepth 1 ! -name bluerig -exec rm -rf {} +
  find "${pkgdir}/usr/lib/bluerig" -mindepth 1 -maxdepth 1 ! -name runtime-plugins \
    -exec rm -rf {} +
  find "${pkgdir}/usr/share" -mindepth 1 -maxdepth 1 ! -name bluerig -exec rm -rf {} +
  find "${pkgdir}/usr/share/bluerig" -mindepth 1 -maxdepth 1 ! -name lua -exec rm -rf {} +
  install -Dm644 "bluerig-${pkgver}/COPYING" "${pkgdir}/usr/share/licenses/bluerig-lua/COPYING"
}
